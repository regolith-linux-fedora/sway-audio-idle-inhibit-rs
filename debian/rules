#!/usr/bin/make -f

# Cargo.lock pins every dependency. For an offline build, vendor the
# crates first (see README.md).
export CARGO_TARGET_DIR = $(CURDIR)/target

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --locked
endif

override_dh_auto_install:
	install -D -m 0755 target/release/sway-audio-idle-inhibit \
		debian/sway-audio-idle-inhibit/usr/bin/sway-audio-idle-inhibit
	install -D -m 0644 sway-audio-idle-inhibit.service \
		debian/sway-audio-idle-inhibit/usr/lib/systemd/user/sway-audio-idle-inhibit.service

override_dh_auto_clean:
	rm -rf target
